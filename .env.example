# Agentic Risk Analysis - Environment Configuration Template
# Copy this file to .env and populate your secrets

# API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here

# Runtime & Device Configuration
AGENT_RISK_ENV=development
RANDOM_SEED=42
DEVICE=cuda  # 'cuda' or 'cpu'
LOG_LEVEL=INFO

# Model Endpoints & Paths
DEFAULT_LLM_MODEL=llama-3.1-70b-versatile
LOCAL_MODEL_PATH=models/lora_adapters/stage_02_lora
XGBOOST_MODEL_PATH=models/xgboost/risk_classifier.json

# Shield Thresholds
RISK_THRESHOLD_WARNING=0.35
RISK_THRESHOLD_BLOCK=0.70
NECESSITY_THRESHOLD=0.40
